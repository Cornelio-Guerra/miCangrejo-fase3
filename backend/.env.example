# Plantilla de configuracion del backend.
# Copia este archivo como backend/.env y reemplaza solamente los valores que vayas a usar.
# Nunca subas backend/.env a GitHub: puede contener claves privadas.

# CORS para desarrollo local
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de datos
# Vacio = SQLite local en backend/data/micangrejo.db
DATABASE_URL=
# Ejemplo Supabase (pooler en modo transaccion, puerto 6543):
# DATABASE_URL=postgresql://postgres.xxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# IA de Google Gemini
# Vacio = clasificacion por reglas, sin llamadas a Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=20
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.7-flash
# 0 = respuestas rapidas; auto = lo decide el modelo
GEMINI_THINKING_BUDGET=0

# Correo SMTP
# Vacio SMTP_USER/SMTP_PASSWORD = correo simulado, no envia mensajes reales.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TIMEOUT_S=15
# Durante el reto, puedes dirigir todos los correos a este buzon de prueba.
MAIL_DEMO_OVERRIDE_TO=

# Fotos en Supabase Storage
# Vacio = los reportes funcionan sin subir fotos.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=evidencias
MAX_PHOTO_BYTES=5242880

# WhatsApp Cloud API (Meta for Developers)
# Vacio = el webhook no usa la API de WhatsApp.
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v22.0

# Reglas de negocio
SLA_DIAS=5

# URL publica del backend (necesaria para enlaces/webhooks en despliegue)
PUBLIC_BASE_URL=

# Telegram Bot API
# El secreto lo inventas tu; debe coincidir con secret_token al registrar el webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://tu-dominio.com/api/v1/webhooks/telegram
